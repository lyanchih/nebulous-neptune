---
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';
import { getHomePermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '', theme = 'light' } = Astro.props;
---

<footer class="border-t border-slate-800 bg-slate-950">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-8 sm:px-6 lg:px-8 sm:flex-row sm:items-start sm:justify-between">
    {/* 左側：公司資訊 */}
    <div class="space-y-2">
      <p class="text-sm font-semibold text-primary-300">
        有限責任新北市原住民第一水電消防勞動合作社
      </p>
      <p class="text-xs text-slate-400 leading-relaxed">
        原住民在地專業團隊｜消防工程・水電工程・室內裝修工程<br />
        服務對象涵蓋國中小、高中職、原鄉學校、中央及地方機關、國營事業與社福機構。
      </p>
      <p class="text-[11px] text-slate-500">
        © {new Date().getFullYear()} 原民第一水電消防合作社. All rights reserved.
      </p>
    </div>

    {/* 右側：簡易連結 / 聯絡方式（可依實際調整） */}
    <div class="flex flex-col gap-3 text-xs text-slate-400">
      <div>
        <p class="font-semibold text-slate-200">快速連結</p>
        <div class="mt-2 flex flex-wrap gap-3">
          <a href="/projects" class="hover:text-primary-300 transition-colors">公共工程實績</a>
          <a href="/about" class="hover:text-primary-300 transition-colors">合作社簡介</a>
          <a href="/contact" class="hover:text-primary-300 transition-colors">聯絡方式</a>
        </div>
      </div>
      {/* 你有統編 / 地址 / 電話可以放在這裡 */}
      {/* <p>統一編號：xxxxxxx　地址：xxxxxxx　電話：xx-xxxx-xxxx</p> */}
    </div>
  </div>
</footer>
